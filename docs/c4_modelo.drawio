e=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="975" y="228"/><mxPoint x="975" y="335"/></Array></mxGeometry></mxCell><mxCell id="c18" value="Consulta datos con sus herramientas&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS + JWT del usuario]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Guarda historial y métricas&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[SQL]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="504"/></Array></mxGeometry></mxCell><mxCell id="c20" value="Genera la respuesta&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Sube los reportes Excel&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="916" y="720"/></Array></mxGeometry></mxCell><mxCell id="c22" value="Descarga el Excel&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[URL firmada · HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c6" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="805"/><mxPoint x="1110" y="805"/></Array></mxGeometry></mxCell><mxCell id="c23" value="" style="rounded=1;fillColor=#08427B;strokeColor=#073B6F;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="26" height="18" as="geometry"/></mxCell><mxCell id="c24" value="Persona" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="867" width="150" height="24" as="geometry"/></mxCell><mxCell id="c25" value="" style="rounded=1;fillColor=#438DD5;strokeColor=#3C7FC0;" vertex="1" parent="1"><mxGeometry x="225" y="870" width="26" height="18" as="geometry"/></mxCell><mxCell id="c26" value="Contenedor" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="257" y="867" width="150" height="24" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;fillColor=#999999;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="410" y="870" width="26" height="18" as="geometry"/></mxCell><mxCell id="c28" value="Sistema externo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="442" y="867" width="150" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c4-n3" name="Nivel 3 - Componentes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Nivel 3 — Diagrama de componentes del chatbot «Miguel»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#555555&quot;&gt;Contenedor: Edge Function «chat» (Deno + Vercel AI SDK, Supabase)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1300" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aplicación web (SPA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: React + Vite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Interfaz del chat.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="200" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Chatbot «Miguel» — Edge Function «chat»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="290" y="30" width="1090" height="840" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Autenticación y alcance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: requireAuth · alcanceSecciones]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Valida el JWT y calcula las secciones permitidas (admin: todas · docente: las suyas).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="70" width="250" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;Controlador del chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: handler HTTP + streamText]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;POST /chat y GET del historial. Arma el prompt con las reglas del colegio y ejecuta el agente (máx. 8 pasos).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="250" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;Historial de conversaciones&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Crea la conversación, guarda los mensajes y los recarga como contexto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="200" width="230" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Registro de métricas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: clasificarIndicador]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Guarda tokens, latencia, herramientas y tipo de indicador (notas, asistencia…).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="340" width="230" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Herramientas de consulta&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: tools del agente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Perfil, años, estructura, cursos, matrículas, docentes, notas y asistencia por sección. Aplica el alcance del usuario.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="480" width="230" height="130" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Herramientas de reportes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: tools del agente]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reportes Excel de indicadores, evolución y asistencia. Valida año/nivel y limita al docente a sus grados.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="190" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Herramienta de gráficos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: mostrar_grafico]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Devuelve los datos para dibujar gráficos en el chat.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="230" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cliente de API académica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Componente: academico()]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Llama a las Edge Functions con el JWT del usuario.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="730" width="190" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:14px&quot;&gt;API académica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Edge Functions]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;CRUD, notas y reportes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="920" width="250" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tablas mg_*, conversaciones, mensajes, métricas.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1"><mxGeometry x="1480" y="200" width="220" height="400" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:14px&quot;&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Valida el JWT.&lt;/font&gt;" sty