<mxfile host="app.diagrams.net"><diagram id="c4-n1" name="Nivel 1 - Contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Nivel 1 — Diagrama de contexto del sistema&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#555555&quot;&gt;Sistema de Gestión Académica «Miguel» · I.E. Almirante Miguel Grau Seminario&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1300" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Gestiona años lectivos, niveles, grados, secciones, cursos, docentes, alumnos, matrículas y programación; descarga reportes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="260" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Docente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registra asistencia y calificaciones de sus secciones asignadas y consulta información académica.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="260" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Sistema de Gestión Académica «Miguel»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Gestiona la información académica del colegio, genera reportes de indicadores y ofrece un asistente conversacional (chatbot).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="320" height="230" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;OpenAI API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Modelo de lenguaje que redacta las respuestas del chatbot.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="280" height="150" as="geometry"/></mxCell><mxCell id="c8" value="Gestiona datos y descarga reportes Excel&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Registra asistencia y notas; consulta con el chatbot&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="Envía la consulta y recibe la respuesta&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS · API REST]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSize=10;fontColor=#404040;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="rounded=1;fillColor=#08427B;strokeColor=#073B6F;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="26" height="18" as="geometry"/></mxCell><mxCell id="c12" value="Persona" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="72" y="697" width="150" height="24" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=1;fillColor=#1168BD;strokeColor=#0B4884;" vertex="1" parent="1"><mxGeometry x="225" y="700" width="26" height="18" as="geometry"/></mxCell><mxCell id="c14" value="Sistema en alcance" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="257" y="697" width="150" height="24" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=1;fillColor=#999999;strokeColor=#8A8A8A;" vertex="1" parent="1"><mxGeometry x="410" y="700" width="26" height="18" as="geometry"/></mxCell><mxCell id="c16" value="Sistema externo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="442" y="697" width="150" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c4-n2" name="Nivel 2 - Contenedores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:18px&quot;&gt;Nivel 2 — Diagrama de contenedores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#555555&quot;&gt;Sistema de Gestión Académica «Miguel» · frontend en Vercel, backend en Supabase&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="0" width="1300" height="48" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Administrador o docente del colegio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;verticalAlign=middle;shape=mxgraph.c4.person2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="230" height="170" as="geometry"/></mxCell><mxCell id="c5" value="Sistema de Gestión Académica «Miguel»" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 4;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="910" height="790" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Aplicación web (SPA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: React + Vite · Vercel]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Interfaz de gestión académica: asistencia, calificaciones, configuración y chat. Genera Excel, Word y PDF en el navegador.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="310" width="230" height="190" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;API académica&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Edge Functions (Deno) · Supabase]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;API REST: login con roles, CRUD de entidades académicas (años, niveles, matrículas, programación…), notas, asistencia y reportes Excel.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="240" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;Chatbot «Miguel»&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Edge Function «chat» · Vercel AI SDK]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Agente conversacional con herramientas de consulta. Respuesta en streaming (SSE) y persistencia del historial.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="470" width="240" height="170" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: servicio de autenticación]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Usuarios y emisión de JWT (access y refresh token).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="70" width="200" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: PostgreSQL · Supabase]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Modelo académico (mg_*), conversaciones, mensajes, métricas y procedimientos almacenados.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="200" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Almacenamiento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contenedor: Supabase Storage]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bucket privado con los reportes .xlsx (URL firmada).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="660" width="200" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;OpenAI API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Modelo de lenguaje (gpt-4.1-mini).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="490" width="230" height="130" as="geometry"/></mxCell><mxCell id="c13" value="Usa el sistema&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[HTTPS]&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;dashed=1;dashPattern=8 4;strokeColor=#707070;strokeWidth=2;fontSi