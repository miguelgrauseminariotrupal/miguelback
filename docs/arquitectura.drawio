lue="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="93" y="190" width="24" height="24" as="geometry" /></mxCell><mxCell id="s33" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="297" width="24" height="24" as="geometry" /></mxCell><mxCell id="s34" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF8000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="538" y="238" width="24" height="24" as="geometry" /></mxCell><mxCell id="s35" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF8000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="177" width="24" height="24" as="geometry" /></mxCell><mxCell id="s36" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF8000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="788" y="236" width="24" height="24" as="geometry" /></mxCell><mxCell id="s37" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1035" y="285" width="24" height="24" as="geometry" /></mxCell><mxCell id="s38" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF8000;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1148" y="222" width="24" height="24" as="geometry" /></mxCell><mxCell id="s39" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="417" width="24" height="24" as="geometry" /></mxCell><mxCell id="s40" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1288" y="600" width="24" height="24" as="geometry" /></mxCell><mxCell id="s41" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="985" y="543" width="24" height="24" as="geometry" /></mxCell><mxCell id="s42" value="&lt;b&gt;Flujo&lt;/b&gt;&lt;br&gt;1  El navegador descarga la SPA desde Vercel (HTML/JS/CSS).&lt;br&gt;2  API académica: REST sobre HTTPS con JWT, directo a Supabase.&lt;br&gt;&lt;font color='#B85000'&gt;&lt;b&gt;3  Chatbot: POST /chat (JWT) y respuesta en streaming SSE.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#B85000'&gt;&lt;b&gt;4  La función chat genera la respuesta con OpenAI (la clave vive solo en Supabase).&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#B85000'&gt;&lt;b&gt;5  El chatbot usa herramientas: llama a la API académica con el JWT del usuario.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;6  Las funciones leen y escriben en PostgreSQL (service_role, procedimientos obtener_*).&lt;br&gt;&lt;font color='#B85000'&gt;&lt;b&gt;7  El chatbot guarda historial y métricas (conversaciones, mensajes, metricas_consulta).&lt;/b&gt;&lt;/font&gt;&lt;br&gt;8  Los reportes se generan y se suben a Storage como .xlsx.&lt;br&gt;9  El navegador descarga el Excel con una URL firmada con vencimiento.&lt;br&gt;10 El login valida las credenciales con Supabase Auth y emite el JWT.&lt;br&gt;&lt;font color='#B85000'&gt;- - -  api/chat.js: ruta de compatibilidad que reenvía al chat (el front actual llama a Supabase directo).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#CCCCCC;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="1030" height="175" as="geometry" /></mxCell><mxCell id="s43" value="&lt;b&gt;Naranja = chatbot «Miguel»&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#B85000;fillColor=#FFE8CC;strokeColor=#FF8000;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="760" width="350" height="28" as="geometry" /></mxCell><mxCell id="s44" value="Íconos genéricos con el color de cada marca: Vercel (negro), Supabase (verde), PostgreSQL (azul), OpenAI (verde azulado)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fillColor=none;strokeColor=none;spacing=6;" vertex="1" parent="1"><mxGeometry x="1080" y="795" width="350" height="80" as="geometry" /></mxCell><mxCell id="logo_vercel" value="" style="shape=image;html=1;aspect=fixed;imageAspect=1;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="410" y="72" width="96" height="48" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>